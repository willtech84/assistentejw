# Copie este arquivo para .env.local e preencha com os dados do seu
# projeto Supabase (Project Settings > API no dashboard).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave pública VAPID (par gerado uma única vez para o projeto). A
# chave PRIVADA nunca vai aqui — ela fica só como secret da Edge
# Function send-lembretes (supabase secrets set). Veja o README.
VITE_VAPID_PUBLIC_KEY=
